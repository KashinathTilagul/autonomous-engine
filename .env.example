# ──────────────────────────────────────────────────────────────────────────────
#  Autonomous UI Bug-Finding & Fix Engine – Environment Variables
#  Configured for OmniRoute with Free Models
# ──────────────────────────────────────────────────────────────────────────────

# ── OmniRoute Gateway ─────────────────────────────────────────────────────────
# API key (optional for free tier models or enter your OmniRoute API key)
OMNIROUTE_API_KEY=

# Best Free Model Selected by Default (DeepSeek R1 Free / Gemini 2.0 Flash Free / Llama 3.3 Free)
MODEL_NAME=deepseek/deepseek-r1:free

# OmniRoute Base URL
OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1

# Temperature for the LLM
LLM_TEMPERATURE=0.0

# Maximum tokens the LLM may generate per call
LLM_MAX_TOKENS=4096

# ── OpenHands ("Hands") ────────────────────────────────────────────────────────
OPENHANDS_API_URL=http://localhost:3000
OPENHANDS_API_KEY=
OPENHANDS_TIMEOUT_SECONDS=600

# ── GitHub ─────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=
REPO_NAME=KashinathTilagul/autonomous-engine
GITHUB_BASE_BRANCH=main

# ── QA / Browser ───────────────────────────────────────────────────────────────
TARGET_URLS=https://example.com
DEFAULT_TEST_SCENARIO=Navigate the site as a new user and report any visual or functional bugs.
BROWSER_MAX_STEPS=25

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
