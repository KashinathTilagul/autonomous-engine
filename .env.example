# ──────────────────────────────────────────────────────────────────────────────
#  Autonomous UI Bug-Finding & Fix Engine – Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit your actual .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── LLM / OpenRouter ──────────────────────────────────────────────────────────
# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model identifier supported by OpenRouter (OpenAI-compatible names)
# Examples:
#   x-ai/grok-4                    – xAI Grok-4
#   zhipu/glm-4-9b                 – Zhipu GLM series
#   openai/gpt-4o                  – OpenAI GPT-4o
#   anthropic/claude-3.5-sonnet    – Anthropic Claude
MODEL_NAME=x-ai/grok-4

# OpenRouter base URL (do not change unless you use another OpenAI-compatible proxy)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Temperature for the LLM (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.0

# Maximum tokens the LLM may generate per call
LLM_MAX_TOKENS=4096

# ── OpenHands ("Hands") ────────────────────────────────────────────────────────
# Base URL of the locally running OpenHands Docker service
OPENHANDS_API_URL=http://localhost:3000

# Optional bearer token if your OpenHands instance requires auth
OPENHANDS_API_KEY=

# How long (seconds) to poll OpenHands for task completion before timing out
OPENHANDS_TIMEOUT_SECONDS=600

# ── GitHub ─────────────────────────────────────────────────────────────────────
# Fine-grained PAT with: Contents (rw), Pull requests (rw), Metadata (r)
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Target repository in "owner/repo" format
REPO_NAME=KashinathTilagul/autonomous-engine

# Base branch that PRs will target
GITHUB_BASE_BRANCH=main

# ── QA / Browser ───────────────────────────────────────────────────────────────
# Comma-separated list of URLs to audit on each engine run
TARGET_URLS=https://example.com

# Default test scenario passed to the QA agent
DEFAULT_TEST_SCENARIO=Navigate the site as a new user and report any visual or functional bugs.

# Maximum number of browser steps per test scenario
BROWSER_MAX_STEPS=25

# ── Logging ────────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
